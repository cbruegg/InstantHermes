[Unit]
Description=InstantHermes STT backend (Mistral Voxtral)
After=network-online.target

[Service]
Type=simple
# -u: unbuffered stdout so the background worker's transcription/forwarding logs are actually emitted
ExecStart=/usr/bin/python3 -u %h/InstantHermes-backend/server.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
